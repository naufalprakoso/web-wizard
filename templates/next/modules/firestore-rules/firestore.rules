rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ["admin@example.com"];
    }

    function isPublished() {
      return resource.data.published == true;
    }

    match /siteSettings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{document} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "published", "createdAt", "updatedAt"])
        && request.resource.data.published == false
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
